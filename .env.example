# Public URL of the site — exactly ONE URL, no commas (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://gmsolllc.com

# ─── Contact form email (SMTP) ───────────────────────────────────────────────
# Each form submission sends two emails:
#   1. To MAIL_TO (you): the visitor's details. Hitting "Reply" answers the visitor.
#   2. To the visitor: a confirmation that their message arrived.
#
# Use the SMTP settings of the mailbox that will send the emails
# (usually accounts@gmsolllc.com). Common providers:
#   Google Workspace : SMTP_HOST=smtp.gmail.com        SMTP_PORT=465  (use an App Password)
#   Microsoft 365    : SMTP_HOST=smtp.office365.com    SMTP_PORT=587
#   Zoho Mail        : SMTP_HOST=smtp.zoho.com         SMTP_PORT=465
#   Hostinger        : SMTP_HOST=smtp.hostinger.com    SMTP_PORT=465
#   cPanel hosting   : SMTP_HOST=mail.gmsolllc.com     SMTP_PORT=465

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (SSL), false for port 587 (STARTTLS). Leave empty to decide from the port.
SMTP_SECURE=true
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-app-password

# Sender shown on both emails. The address must be SMTP_USER (or an alias it may send as),
# otherwise most providers reject the email or mark it as spam.
MAIL_FROM="GM Solution LLC <yourname@gmail.com>"

# Inbox that receives new inquiries. Separate several addresses with commas.
MAIL_TO=yourname@gmail.com